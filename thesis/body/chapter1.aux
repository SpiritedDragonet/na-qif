\@writefile{lof}{\contentsline {figure}{\numberline {1.1}{\ignorespaces 可扩展量子计算的规模化运行压力。物理比特扩容、并行读出反馈、长时纠错运行和标定闭环维护共同把问题从单器件性能推向体系结构设计。控制扇出、综合征吞吐、逻辑寿命预算和漂移追踪分别对应可观察的工程瓶颈。}}{3}{figure.1.1}\protected@file@percent }
\newlabel{fig:ch1_system_pressure}{{1.1}{3}{可扩展量子计算的规模化运行压力。物理比特扩容、并行读出反馈、长时纠错运行和标定闭环维护共同把问题从单器件性能推向体系结构设计。控制扇出、综合征吞吐、逻辑寿命预算和漂移追踪分别对应可观察的工程瓶颈。}{figure.1.1}{}}
